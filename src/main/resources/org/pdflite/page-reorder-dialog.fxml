<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.pdflite.controller.PageReorderDialogController"
      styleClass="dialog-container" prefWidth="800" prefHeight="600">

    <!-- Custom Title Bar -->
    <HBox fx:id="dialogTitleBar" styleClass="dialog-title-bar"/>

    <!-- Main Content -->
    <VBox VBox.vgrow="ALWAYS" spacing="15" style="-fx-padding: 20;">

        <!-- Header Section -->
        <VBox spacing="8">
            <Label fx:id="fileNameLabel" text="Document.pdf" styleClass="dialog-header"/>
            <Label fx:id="totalPagesLabel" text="Total Pages: 0" styleClass="dialog-subheader"/>
            <Label text="Drag and drop thumbnails to reorder pages" styleClass="dialog-hint"/>
        </VBox>

        <!-- Thumbnail Preview Area -->
        <ScrollPane fx:id="previewScrollPane" VBox.vgrow="ALWAYS" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-border-color: #ccc; -fx-border-width: 1;">
            <FlowPane fx:id="previewPane" hgap="15" vgap="15" alignment="TOP_LEFT" style="-fx-padding: 15;"/>
        </ScrollPane>

        <!-- Status Bar -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="statusLabel" text="Ready" HBox.hgrow="ALWAYS"/>
            <ProgressBar fx:id="progressBar" prefWidth="200" visible="false" managed="false"/>
        </HBox>

        <!-- Action Buttons -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="resetButton" text="Reset Order" onAction="#handleReset" prefWidth="100"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel" prefWidth="80"/>
            <Button fx:id="applyButton" text="Apply" onAction="#handleApply" prefWidth="80"
                    styleClass="primary-button"/>
        </HBox>
    </VBox>
</VBox>
