<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.pdflite.controller.MergeDialogController"
            prefWidth="700" prefHeight="500">

    <!-- Top: Title and Instructions -->
    <top>
        <VBox spacing="10" styleClass="dialog-header">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Merge PDF Files" styleClass="dialog-title"/>
            <Label text="Add multiple PDF files, reorder them by dragging, and merge into a single document."
                   styleClass="dialog-label-muted" wrapText="true"/>
        </VBox>
    </top>

    <!-- Center: File List Table -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <!-- Toolbar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="addFilesButton" text="Add Files..." onAction="#handleAddFiles"/>
                <Button fx:id="removeButton" text="Remove" onAction="#handleRemove"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="moveUpButton" text="↑ Move Up" onAction="#handleMoveUp"/>
                <Button fx:id="moveDownButton" text="↓ Move Down" onAction="#handleMoveDown"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Drag rows to reorder" styleClass="dialog-label-muted"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="filesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="orderColumn" text="#" prefWidth="40" minWidth="40" maxWidth="60"/>
                    <TableColumn fx:id="fileNameColumn" text="File Name" prefWidth="300" minWidth="150"/>
                    <TableColumn fx:id="pagesColumn" text="Pages" minWidth="60"/>
                    <TableColumn fx:id="sizeColumn" text="Size" prefWidth="100" minWidth="80"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <!-- Bottom: Status and Actions -->
    <bottom>
        <VBox spacing="10" styleClass="dialog-footer">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <!-- Progress Bar -->
            <ProgressBar fx:id="progressBar" prefWidth="Infinity" managed="false" visible="false"/>

            <!-- Status Label -->
            <Label fx:id="statusLabel" text="Ready to merge" styleClass="dialog-label-muted"/>

            <!-- Action Buttons -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="mergeButton" text="Merge PDFs" onAction="#handleMerge"
                        styleClass="primary-button"
                        prefWidth="120"/>
                <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel" prefWidth="100"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
