<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.pdflite.controller.ExtractDialogController"
      styleClass="extract-dialog"
      minWidth="800" minHeight="600">

    <!-- Custom Title Bar -->
    <HBox fx:id="dialogTitleBar" styleClass="custom-title-bar" prefHeight="32" minHeight="32" maxHeight="32"/>

    <!-- Content -->
    <BorderPane VBox.vgrow="ALWAYS">
        <!-- Top: File Info -->
        <top>
            <VBox spacing="10" styleClass="dialog-header">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <HBox spacing="10">
                    <Label fx:id="fileLabelText" text="File:" styleClass="dialog-label-strong"/>
                    <Label fx:id="fileNameLabel" text="No file selected" styleClass="dialog-label-muted"/>
                </HBox>
                <Label fx:id="totalPagesLabel" text="Total Pages: 0" styleClass="dialog-label-muted"/>
            </VBox>
        </top>

    <!-- Center: Preview and Options -->
    <center>
        <SplitPane dividerPositions="0.45" VBox.vgrow="ALWAYS">

            <!-- Left: Page Preview -->
            <VBox spacing="3">
                <padding>
                    <Insets top="5" bottom="3"/>
                </padding>

                <Label fx:id="pagePreviewLabel" text="Page Preview" styleClass="dialog-label-strong">
                    <VBox.margin>
                        <Insets left="8"/>
                    </VBox.margin>
                </Label>

                <ScrollPane fx:id="previewScrollPane" VBox.vgrow="ALWAYS" fitToWidth="true" hbarPolicy="NEVER">
                    <FlowPane fx:id="previewPane" hgap="6" vgap="6" alignment="TOP_CENTER" columnHalignment="CENTER">
                        <padding>
                            <Insets/>
                        </padding>
                    </FlowPane>
                </ScrollPane>
            </VBox>

            <!-- Right: Extract Options -->
            <VBox spacing="15">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="10"/>
                </padding>

                <Label fx:id="extractOptionsLabel" text="Extract Options" styleClass="dialog-label-strong"/>

                <!-- Extract Instructions -->
                <VBox spacing="10">
                    <Label fx:id="selectPagesLabel" text="Select pages to extract:" styleClass="dialog-label-strong"/>
                    <Label fx:id="rangeInstructionsLabel" text="Enter page ranges separated by commas."
                           styleClass="dialog-label-muted" wrapText="true"/>
                    <Label fx:id="examplesLabel" text="Examples:" styleClass="dialog-label-muted" wrapText="true"/>
                    <Label fx:id="example1Label" text="  • 1-5, 10 (pages 1 to 5, and page 10)"
                           styleClass="dialog-label-muted" wrapText="true"/>
                    <Label fx:id="example2Label" text="  • 1, 3, 5-7 (pages 1, 3, and 5 to 7)"
                           styleClass="dialog-label-muted" wrapText="true"/>
                    <Label fx:id="example3Label" text="  • 10-15, 20-25 (pages 10 to 15, and 20 to 25)"
                           styleClass="dialog-label-muted" wrapText="true"/>
                </VBox>

                <Separator/>

                <!-- Page Range Input -->
                <VBox spacing="10">
                    <Label fx:id="pageRangeLabel" text="Page Range:" styleClass="dialog-label-strong"/>
                    <TextArea fx:id="rangeTextArea"
                              promptText="e.g., 1-5, 10, 25-30"
                              prefRowCount="3"
                              wrapText="true"/>
                    <Label fx:id="rangeValidationLabel"
                           styleClass="dialog-label-muted"
                           wrapText="true"/>
                </VBox>

                <Separator/>

                <!-- Output File Name -->
                <VBox spacing="10">
                    <Label fx:id="outputFileLabel" text="Output File Name:" styleClass="dialog-label-strong"/>
                    <TextField fx:id="outputFileNameField"
                               promptText="extracted_pages.pdf"/>
                    <Label fx:id="outputHintLabel" text="If empty, will use: [original_name]_extracted.pdf"
                           styleClass="dialog-label-muted"
                           wrapText="true"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Quick Actions -->
                <VBox spacing="5">
                    <Label fx:id="quickActionsLabel" text="Quick Actions:" styleClass="dialog-label-strong"/>
                    <HBox spacing="5">
                        <Button fx:id="allPagesButton"
                                text="All Pages"
                                onAction="#handleAllPages"/>
                        <Button fx:id="oddPagesButton"
                                text="Odd Pages"
                                onAction="#handleOddPages"/>
                        <Button fx:id="evenPagesButton"
                                text="Even Pages"
                                onAction="#handleEvenPages"/>
                    </HBox>
                </VBox>
            </VBox>

        </SplitPane>
    </center>

    <!-- Bottom: Status and Actions -->
    <bottom>
        <VBox spacing="10" styleClass="dialog-footer">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <!-- Progress Bar -->
            <ProgressBar fx:id="progressBar" prefWidth="Infinity" managed="false" visible="false"/>

            <!-- Status Label -->
            <Label fx:id="statusLabel" text="Ready to extract" styleClass="dialog-label-muted"/>

            <!-- Action Buttons -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="extractButton" text="Extract Pages" onAction="#handleExtract"
                        styleClass="primary-button"
                        prefWidth="120"/>
                <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel" prefWidth="100"/>
            </HBox>
        </VBox>
    </bottom>

    </BorderPane>
</VBox>
