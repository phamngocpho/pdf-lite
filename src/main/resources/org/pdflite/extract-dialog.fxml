<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.pdflite.controller.ExtractDialogController"
            prefWidth="800" prefHeight="600">
    
    <!-- Top: Title and File Info -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #f5f5f5; -fx-padding: 15;">
            <Label text="Extract PDF Pages" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <HBox spacing="10">
                <Label text="File:" style="-fx-font-weight: bold;"/>
                <Label fx:id="fileNameLabel" text="No file selected" style="-fx-text-fill: #333;"/>
            </HBox>
            <Label fx:id="totalPagesLabel" text="Total Pages: 0" style="-fx-text-fill: #666;"/>
        </VBox>
    </top>
    
    <!-- Center: Preview and Options -->
    <center>
        <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">
            
            <!-- Left: Page Preview -->
            <VBox spacing="10">
                <padding>
                    <Insets top="15" right="10" bottom="15" left="15"/>
                </padding>
                
                <Label text="Page Preview" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                
                <ScrollPane fx:id="previewScrollPane" VBox.vgrow="ALWAYS" fitToWidth="true"
                           style="-fx-background-color: #fafafa;">
                    <FlowPane fx:id="previewPane" hgap="10" vgap="10" style="-fx-background-color: #fafafa;">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                    </FlowPane>
                </ScrollPane>
            </VBox>
            
            <!-- Right: Extract Options -->
            <VBox spacing="15">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="10"/>
                </padding>
                
                <Label text="Extract Options" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                
                <!-- Extract Instructions -->
                <VBox spacing="10">
                    <Label text="Select pages to extract:" style="-fx-font-weight: bold;"/>
                    <Label text="Enter page ranges separated by commas." 
                           style="-fx-text-fill: #666; -fx-font-size: 11px;" wrapText="true"/>
                    <Label text="Examples:" style="-fx-text-fill: #666; -fx-font-size: 11px;"/>
                    <Label text="  • 1-5, 10 (pages 1 to 5, and page 10)" 
                           style="-fx-text-fill: #666; -fx-font-size: 10px;"/>
                    <Label text="  • 1, 3, 5-7 (pages 1, 3, and 5 to 7)" 
                           style="-fx-text-fill: #666; -fx-font-size: 10px;"/>
                    <Label text="  • 10-15, 20-25 (pages 10 to 15, and 20 to 25)" 
                           style="-fx-text-fill: #666; -fx-font-size: 10px;"/>
                </VBox>
                
                <Separator/>
                
                <!-- Page Range Input -->
                <VBox spacing="10">
                    <Label text="Page Range:" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="rangeTextArea" 
                             promptText="e.g., 1-5, 10, 25-30"
                             prefRowCount="3"
                             wrapText="true"/>
                    <Label fx:id="rangeValidationLabel"
                           style="-fx-text-fill: #666; -fx-font-size: 10px;"
                           wrapText="true"/>
                </VBox>
                
                <Separator/>
                
                <!-- Output File Name -->
                <VBox spacing="10">
                    <Label text="Output File Name:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="outputFileNameField" 
                              promptText="extracted_pages.pdf"/>
                    <Label text="If empty, will use: [original_name]_extracted.pdf" 
                           style="-fx-text-fill: #666; -fx-font-size: 10px;" 
                           wrapText="true"/>
                </VBox>
                
                <Region VBox.vgrow="ALWAYS"/>
                
                <!-- Quick Actions -->
                <VBox spacing="5">
                    <Label text="Quick Actions:" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                    <HBox spacing="5">
                        <Button fx:id="allPagesButton" 
                               text="All Pages" 
                               onAction="#handleAllPages"
                               style="-fx-font-size: 10px;"/>
                        <Button fx:id="oddPagesButton" 
                               text="Odd Pages" 
                               onAction="#handleOddPages"
                               style="-fx-font-size: 10px;"/>
                        <Button fx:id="evenPagesButton" 
                               text="Even Pages" 
                               onAction="#handleEvenPages"
                               style="-fx-font-size: 10px;"/>
                    </HBox>
                </VBox>
            </VBox>
            
        </SplitPane>
    </center>
    
    <!-- Bottom: Status and Actions -->
    <bottom>
        <VBox spacing="10" style="-fx-background-color: #f5f5f5;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            
            <!-- Progress Bar -->
            <ProgressBar fx:id="progressBar" prefWidth="Infinity" managed="false" visible="false"/>
            
            <!-- Status Label -->
            <Label fx:id="statusLabel" text="Ready to extract" style="-fx-text-fill: #666;"/>
            
            <!-- Action Buttons -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="extractButton" text="Extract Pages" onAction="#handleExtract"
                        style="-fx-font-weight: bold; -fx-background-color: #4CAF50; -fx-text-fill: white;"
                        prefWidth="120"/>
                <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel" prefWidth="100"/>
            </HBox>
        </VBox>
    </bottom>
    
</BorderPane>

