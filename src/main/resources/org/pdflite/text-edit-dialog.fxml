<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.pdflite.dialog.TextEditDialogController"
      spacing="10" prefWidth="400" prefHeight="200">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Edit Text" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

    <Label text="Original Text:" style="-fx-font-size: 12px;"/>
    <TextArea fx:id="originalTextArea" editable="false" wrapText="true" prefRowCount="2"
              style="-fx-opacity: 0.7;"/>

    <Label text="New Text:" style="-fx-font-size: 12px;"/>
    <TextArea fx:id="newTextArea" wrapText="true" prefRowCount="3"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" prefWidth="80"/>
        <Button text="OK" onAction="#handleOK" defaultButton="true" prefWidth="80"/>
    </HBox>
</VBox>
