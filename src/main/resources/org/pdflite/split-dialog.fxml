<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.pdflite.controller.SplitDialogController"
      styleClass="split-dialog"
      minWidth="900" minHeight="600">

    <!-- Custom Title Bar -->
    <HBox fx:id="dialogTitleBar" styleClass="custom-title-bar" prefHeight="32" minHeight="32" maxHeight="32"/>

    <!-- Content -->
    <BorderPane VBox.vgrow="ALWAYS">
        <!-- Top: File Info -->
        <top>
            <VBox spacing="10" styleClass="dialog-header">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <HBox spacing="10">
                    <Label text="File:" styleClass="dialog-label-strong"/>
                    <Label fx:id="fileNameLabel" text="No file selected" styleClass="dialog-label-muted"/>
                </HBox>
                <Label fx:id="totalPagesLabel" text="Total Pages: 0" styleClass="dialog-label-muted"/>
            </VBox>
        </top>

    <!-- Center: Preview and Options -->
    <center>
        <SplitPane dividerPositions="0.45" VBox.vgrow="ALWAYS">

            <!-- Left: Page Preview -->
            <VBox spacing="3">
                <padding>
                    <Insets top="5" bottom="3"/>
                </padding>

                <Label text="Page Preview" styleClass="dialog-label-strong">
                    <VBox.margin>
                        <Insets left="8"/>
                    </VBox.margin>
                </Label>

                <ScrollPane fx:id="previewScrollPane" VBox.vgrow="ALWAYS" fitToWidth="true" hbarPolicy="NEVER">
                    <FlowPane fx:id="previewPane" hgap="6" vgap="6" alignment="TOP_LEFT" columnHalignment="LEFT">
                        <padding>
                            <Insets left="6"/>
                        </padding>
                    </FlowPane>
                </ScrollPane>
            </VBox>

            <!-- Right: Split Options -->
            <VBox spacing="15">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="10"/>
                </padding>

                <Label text="Split Options" styleClass="dialog-label-strong"/>

                <!-- Split Mode Selection -->
                <VBox spacing="10">

                    <!-- Option 1: Split by Custom Ranges -->
                    <RadioButton fx:id="splitByRangeRadio" text="Split by Custom Ranges"
                                 style="-fx-font-weight: bold;"/>

                    <VBox fx:id="rangeInputBox" spacing="10" style="-fx-padding: 0 0 0 25;">
                        <Label text="Enter page ranges (e.g., 1-5, 10-15):"
                               styleClass="dialog-label-muted"/>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="rangeTextField" promptText="e.g., 1-5" prefWidth="200"/>
                            <Button fx:id="addRangeButton" text="Add Range" onAction="#handleAddRange"/>
                        </HBox>

                        <Label text="Selected Ranges:" styleClass="dialog-label-muted"/>
                        <ListView fx:id="rangesListView" prefHeight="80" minHeight="50" maxHeight="150"/>

                        <HBox spacing="10">
                            <Button fx:id="removeRangeButton" text="Remove Selected" onAction="#handleRemoveRange"/>
                        </HBox>
                    </VBox>

                    <Separator/>

                    <!-- Option 2: Split by Page Count -->
                    <RadioButton fx:id="splitByPagesRadio" text="Split by Page Count"
                                 style="-fx-font-weight: bold;"/>

                    <VBox fx:id="pagesInputBox" spacing="10" style="-fx-padding: 0 0 0 25;">
                        <Label text="Number of pages per file:" styleClass="dialog-label-muted"/>
                        <TextField fx:id="pagesPerFileTextField" promptText="e.g., 10" prefWidth="150"/>
                    </VBox>

                    <Separator/>

                    <!-- Option 3: Split All Pages -->
                    <RadioButton fx:id="splitAllPagesRadio" text="Split into Individual Pages"
                                 style="-fx-font-weight: bold;"/>

                    <Label text="Each page will be saved as a separate PDF file."
                           styleClass="dialog-label-muted" wrapText="true"/>
                </VBox>

                <Separator/>

                <!-- Output Options -->
                <VBox spacing="10">
                    <Label text="Output Options" styleClass="dialog-label-strong"/>
                    <CheckBox fx:id="zipOutputCheckBox" text="Create ZIP archive of split files"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>

        </SplitPane>
    </center>

    <!-- Bottom: Status and Actions -->
    <bottom>
        <VBox spacing="10" styleClass="dialog-footer">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <!-- Progress Bar -->
            <ProgressBar fx:id="progressBar" prefWidth="Infinity" managed="false" visible="false"/>

            <!-- Status Label -->
            <Label fx:id="statusLabel" text="Ready to split" styleClass="dialog-label-muted"/>

            <!-- Action Buttons -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="splitButton" text="Split PDF" onAction="#handleSplit"
                        styleClass="primary-button"
                        prefWidth="120"/>
                <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel" prefWidth="100"/>
            </HBox>
        </VBox>
    </bottom>

    </BorderPane>
</VBox>
