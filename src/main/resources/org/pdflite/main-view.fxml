<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.Color?> <BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
                                                fx:controller="org.pdflite.controller.MainController"
                                                prefHeight="800.0" prefWidth="1200.0">

    <top>
        <VBox>
            <MenuBar>
                <Menu text="File">
                    <MenuItem text="Open PDF..." onAction="#handleOpenPDF" accelerator="Ctrl+O"/>
                    <MenuItem text="Save" onAction="#handleSave"/>
                    <MenuItem text="Save As..." onAction="#handleSaveAs"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Exit" onAction="#handleExit"/>
                </Menu>

                <Menu text="Edit">
                    <MenuItem text="Find..." onAction="#handleSearch" accelerator="Ctrl+F"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Hide Search Panel" onAction="#handleHideSearch" accelerator="Escape"/>
                </Menu>

                <Menu text="View">
                    <MenuItem text="Zoom In" onAction="#handleZoomIn" accelerator="Ctrl+Plus"/>
                    <MenuItem text="Zoom Out" onAction="#handleZoomOut" accelerator="Ctrl+Minus"/>
                    <MenuItem text="Fit to Width" onAction="#handleFitToWidth"/>
                    <MenuItem text="Fit to Page" onAction="#handleFitToPage"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Toggle Full Screen" onAction="#handleToggleFullScreen" accelerator="F11"/>
                </Menu>

                <Menu text="Tools">
                    <MenuItem text="Highlight" onAction="#handleHighlight"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Merge PDFs..." onAction="#handleMergePDFs"/>
                    <MenuItem text="Split PDF..." onAction="#handleSplitPDF"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Delete Page" onAction="#handleDeletePage"/>
                </Menu>

                <Menu text="Help">
                    <MenuItem text="About" onAction="#handleAbout"/>
                </Menu>
                <Menu text="Theme">
                    <MenuItem text ="Light" onAction="#setLightTheme" />
                    <MenuItem text ="Dark" onAction="#setDarkTheme" />
                </Menu>
            </MenuBar>

            <ToolBar fx:id="toolbar">
                <Button text="Open" onAction="#handleOpenPDF"/>
                <Button text="Save" onAction="#handleSave"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="prevButton" text="Previous" onAction="#handlePreviousPage"/>
                <Label text="Page:"/>
                <TextField fx:id="pageNumberField" prefWidth="50" onAction="#handleGoToPage"/>
                <Label fx:id="totalPagesLabel" text="/ 0"/>
                <Button fx:id="nextButton" text="Next" onAction="#handleNextPage"/>
                <Separator orientation="VERTICAL"/>
                <Button text="Zoom In" onAction="#handleZoomIn"/>
                <Button text="Zoom Out" onAction="#handleZoomOut"/>
                <ComboBox fx:id="zoomComboBox" onAction="#handleZoomChange" prefWidth="100"/>
                <Separator orientation="VERTICAL"/>
                <Button text="Highlight" onAction="#handleHighlight"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="rotateLeftButton" text="↶ Left" onAction="#handleRotateLeft"/>
                <Button fx:id="rotateRightButton" text="Right ↷" onAction="#handleRotateRight"/>
                <Separator orientation="VERTICAL"/>
                <ComboBox fx:id="drawingToolComboBox" prefWidth="100" promptText="Select Tool"/>
                <Label text="Color:"/>
                <ColorPicker fx:id="colorPicker" prefWidth="45">
                    <value>
                        <Color red="0.0" green="0.0" blue="0.0" />
                    </value>
                </ColorPicker>
                <Label text="Width:"/>
                <Slider fx:id="lineWidthSlider" min="1" max="10" value="1" prefWidth="100" showTickMarks="true" majorTickUnit="1" blockIncrement="1"/>
                <Separator orientation="VERTICAL"/>
                <Button text="Merge PDFs" onAction="#handleMergePDFs" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button text="Split PDF" onAction="#handleSplitPDF" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
                <Separator orientation="VERTICAL"/>
                <Button text="Merge PDFs" onAction="#handleMergePDFs" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button text="Split PDF" onAction="#handleSplitPDF" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
                <Separator orientation="VERTICAL"/>
                <Button text="Delete Page" onAction="#handleDeletePage"/>
                <Button text="Full Screen" onAction="#handleToggleFullScreen"/>

                <MenuButton text="🔍" style="-fx-font-size: 14px;">
                    <tooltip>
                        <Tooltip text="Search in document"/>
                    </tooltip>
                    <items>
                        <MenuItem text="Float" onAction="#handleSearch"/>
                        <MenuItem text="Left" onAction="#handleSearchLeft"/>
                        <MenuItem text="Right" onAction="#handleSearchRight"/>
                    </items>
                </MenuButton>

                <Separator orientation="VERTICAL"/>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" fitToHeight="true">
            <StackPane fx:id="contentPane" style="-fx-background-color: #808080;">
                <Label text="Open a PDF file to start" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
            </StackPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 5; -fx-background-color: #f0f0f0;">
            <Label fx:id="statusLabel" text="Ready"/>
        </HBox>
    </bottom>

</BorderPane>