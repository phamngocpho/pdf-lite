<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.pdflite.controller.MainController"
            prefHeight="800.0" prefWidth="1200.0">

    <fx:define>
        <ToggleGroup fx:id="drawingToolsGroup"/>
        <ToggleGroup fx:id="themeGroup"/>
    </fx:define>

    <!-- Top: Custom Title Bar, Menu Bar and Toolbar -->
    <top>
        <VBox>
            <!-- Custom Title Bar -->
            <HBox fx:id="customTitleBar" styleClass="custom-title-bar" alignment="CENTER_LEFT">
                <HBox alignment="CENTER_LEFT">
                    <ImageView fx:id="logoImageView" fitWidth="28" fitHeight="28" preserveRatio="true">
                        <Image url="@images/logo_dark.png"/>
                        <HBox.margin>
                            <Insets left="8"/>
                        </HBox.margin>
                    </ImageView>
                    <Label fx:id="titleLabel" text="PDF Lite - PDF Viewer &amp; Editor" styleClass="title-bar-label"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Save Status Indicator -->
                <StackPane fx:id="saveStatusIndicator" visible="false" managed="false">
                    <HBox.margin>
                        <Insets right="10"/>
                    </HBox.margin>
                </StackPane>
                <Button fx:id="minimizeButton" text="_" styleClass="title-bar-button,minimize-button" onAction="#handleMinimize" focusTraversable="false"/>
                <Button fx:id="maximizeButton" text="□" styleClass="title-bar-button,maximize-button" onAction="#handleMaximize" focusTraversable="false"/>
                <Button fx:id="closeButton" text="✕" styleClass="title-bar-button,close-button" onAction="#handleClose" focusTraversable="false"/>
            </HBox>

            <!-- Menu Bar -->
            <MenuBar>
                <Menu text="File">
                    <MenuItem text="Open PDF..." onAction="#handleOpenPDF" accelerator="Ctrl+O"/>
                    <Menu fx:id="recentFilesMenu" text="Recent Files">
                        <MenuItem text="No recent files" disable="true"/>
                    </Menu>
                    <MenuItem text="Clear Recent Files" onAction="#handleClearRecentFiles"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Export..." onAction="#handleExport" accelerator="Ctrl+Shift+E"/>
                    <MenuItem text="Print..." onAction="#handlePrint" accelerator="Ctrl+P"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Save" onAction="#handleSave" accelerator="Ctrl+S"/>
                    <MenuItem text="Save As..." onAction="#handleSaveAs"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Optimize PDF..." onAction="#handleOptimizePDF" accelerator="Ctrl+Shift+O"/>
                    <MenuItem text="Document Properties..." onAction="#handleDocumentProperties" accelerator="Ctrl+D"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Exit" onAction="#handleExit"/>
                </Menu>

                <Menu text="Edit">
                    <MenuItem text="Edit Text..." onAction="#handleEditText" accelerator="Ctrl+E"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Insert Image..." onAction="#handleInsertImage" accelerator="Ctrl+I"/>
                    <MenuItem text="Insert Stamp..." onAction="#handleInsertStamp"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Find..." onAction="#handleSearch" accelerator="Ctrl+F"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Hide Search Panel" onAction="#handleHideSearch" accelerator="Escape"/>
                </Menu>

                <Menu text="View">
                    <MenuItem text="Zoom In" onAction="#handleZoomIn" accelerator="Ctrl+Plus"/>
                    <MenuItem text="Zoom Out" onAction="#handleZoomOut" accelerator="Ctrl+Minus"/>
                    <MenuItem text="Fit to Width" onAction="#handleFitToWidth"/>
                    <MenuItem text="Fit to Page" onAction="#handleFitToPage"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Toggle Bookmarks" onAction="#handleToggleBookmarks" accelerator="Ctrl+B"/>
                    <MenuItem text="Add Bookmark..." onAction="#handleAddBookmark" accelerator="Ctrl+Shift+B"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="toggleToolbarMenuItem" text="Hide Toolbar" onAction="#handleToggleToolbar"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Toggle Full Screen" onAction="#handleToggleFullScreen" accelerator="F11"/>
                </Menu>

                <Menu text="Tools">
                    <MenuItem text="Highlight" onAction="#handleHighlight"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Add Watermark..." onAction="#handleAddWatermark"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Merge PDFs..." onAction="#handleMergePDFs"/>
                    <MenuItem text="Split PDF..." onAction="#handleSplitPDF"/>
                    <MenuItem text="Extract Pages..." onAction="#handleExtractPages"/>
                    <MenuItem text="Reorder Pages..." onAction="#handleReorderPages"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Encrypt PDF..." onAction="#handleEncryptPDF"/>
                    <MenuItem text="Remove Password..." onAction="#handleDecryptPDF"/>
                    <MenuItem text="Show Permissions..." onAction="#handleShowPDFPermissions"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Delete Page" onAction="#handleDeletePage"/>
                    <MenuItem text="Duplicate Page..." onAction="#handleDuplicatePage"/>
                </Menu>

                <Menu text="Help">
                    <MenuItem text="AI Assistant..." onAction="#handleOpenChat" accelerator="Ctrl+Shift+A"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="About" onAction="#handleAbout"/>
                </Menu>
                <Menu text="Theme">
                    <RadioMenuItem fx:id="systemThemeItem" text="System" onAction="#setSystemTheme" selected="true" toggleGroup="$themeGroup"/>
                    <SeparatorMenuItem/>
                    <RadioMenuItem fx:id="lightThemeItem" text="Light" onAction="#setLightTheme" toggleGroup="$themeGroup"/>
                    <RadioMenuItem fx:id="darkThemeItem" text="Dark" onAction="#setDarkTheme" toggleGroup="$themeGroup"/>
                </Menu>
            </MenuBar>

            <!-- Modern Minimalist Toolbar -->
            <ToolBar fx:id="toolbar" styleClass="main-toolbar">

                <!-- File Operations -->
                <Button text="Open" onAction="#handleOpenPDF">
                    <tooltip><Tooltip text="Open PDF (Ctrl+O)"/></tooltip>
                </Button>
                <Button text="Save" onAction="#handleSave">
                    <tooltip><Tooltip text="Save (Ctrl+S)"/></tooltip>
                </Button>
                <Button text="Print" onAction="#handlePrint">
                    <tooltip><Tooltip text="Print (Ctrl+P)"/></tooltip>
                </Button>

                <Region prefWidth="20"/>

                <!-- Navigation Group -->
                <HBox spacing="3" alignment="CENTER">
                    <Button fx:id="prevButton" text="Previous" onAction="#handlePreviousPage"/>
                    <TextField fx:id="pageNumberField" prefWidth="55" minWidth="55" maxWidth="55" onAction="#handleGoToPage" alignment="CENTER"/>
                    <Label fx:id="totalPagesLabel" text="/ 0" minWidth="50"/>
                    <Button fx:id="nextButton" text="Next" onAction="#handleNextPage"/>
                </HBox>

                <Region prefWidth="20"/>

                <!-- Zoom Group -->
                <HBox spacing="3" alignment="CENTER">
                    <Button text="Zoom Out" onAction="#handleZoomOut"/>
                    <ComboBox fx:id="zoomComboBox" onAction="#handleZoomChange" prefWidth="90" minWidth="90"/>
                    <Button text="Zoom In" onAction="#handleZoomIn"/>
                </HBox>

                <Region prefWidth="20"/>

                <!-- Bookmark Button -->
                <Button text="📑 Bookmarks" onAction="#handleToggleBookmarks">
                    <tooltip><Tooltip text="Toggle Bookmarks (Ctrl+B)"/></tooltip>
                </Button>

                <Region prefWidth="20"/>

                <!-- Drawing Tools Group -->
                <HBox spacing="5" alignment="CENTER" styleClass="drawing-tools-group">
                    <MenuButton fx:id="drawingToolsMenu" text="✏ Draw">
                        <tooltip><Tooltip text="Drawing Tools"/></tooltip>
                        <items>
                            <CustomMenuItem hideOnClick="false">
                                <content>
                                    <VBox spacing="12" styleClass="drawing-tools-popup" style="-fx-padding: 16;">
                                        <!-- Drawing Tools Section -->
                                        <VBox spacing="8">
                                            <Label text="Drawing Tools" styleClass="drawing-tools-section-label"/>
                                            <HBox spacing="8" alignment="CENTER">
                                                <ToggleButton fx:id="btnDrawRect" toggleGroup="$drawingToolsGroup"
                                                              prefWidth="50" prefHeight="50">
                                                    <tooltip><Tooltip text="Rectangle"/></tooltip>
                                                </ToggleButton>
                                                <ToggleButton fx:id="btnDrawCircle" toggleGroup="$drawingToolsGroup"
                                                              prefWidth="50" prefHeight="50">
                                                    <tooltip><Tooltip text="Circle"/></tooltip>
                                                </ToggleButton>
                                                <ToggleButton fx:id="btnDrawArrow" toggleGroup="$drawingToolsGroup"
                                                              prefWidth="50" prefHeight="50">
                                                    <tooltip><Tooltip text="Arrow"/></tooltip>
                                                </ToggleButton>
                                            </HBox>
                                        </VBox>
                                        
                                        <Separator styleClass="drawing-tools-separator"/>
                                        
                                        <!-- Drawing Color Section -->
                                        <VBox spacing="8">
                                            <Label text="Drawing Color" styleClass="drawing-tools-section-label"/>
                                            <ColorPicker fx:id="colorPicker" prefWidth="178" prefHeight="32" maxWidth="178"
                                                         style="-fx-color-label-visible: true;"/>
                                        </VBox>
                                        
                                        <Separator styleClass="drawing-tools-separator"/>
                                        
                                        <!-- Highlight Color Section -->
                                        <VBox spacing="8">
                                            <Label text="Highlight Color" styleClass="drawing-tools-section-label"/>
                                            <ColorPicker fx:id="highlightColorPicker" prefWidth="178" prefHeight="32" maxWidth="178"
                                                         style="-fx-color-label-visible: true;"/>
                                        </VBox>
                                        
                                        <Separator styleClass="drawing-tools-separator"/>
                                        
                                        <!-- Stroke Width Section -->
                                        <VBox spacing="8">
                                            <HBox spacing="5" alignment="CENTER_LEFT">
                                                <Label text="Stroke Width" styleClass="drawing-tools-section-label"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="strokeWidthLabel" text="2" styleClass="stroke-width-value"/>
                                            </HBox>
                                            <Slider fx:id="strokeWidthSlider" min="1" max="10" value="2" 
                                                    prefWidth="170" blockIncrement="1" 
                                                    style="-fx-padding: 4 0;"/>
                                        </VBox>
                                    </VBox>
                                </content>
                            </CustomMenuItem>
                        </items>
                    </MenuButton>
                    
                    <Button fx:id="undoButton" onAction="#handleUndo" prefWidth="35" prefHeight="35">
                        <tooltip><Tooltip text="Undo (Ctrl+Z)"/></tooltip>
                    </Button>
                    
                    <Button fx:id="redoButton" onAction="#handleRedo" prefWidth="35" prefHeight="35">
                        <tooltip><Tooltip text="Redo (Ctrl+Y)"/></tooltip>
                    </Button>
                </HBox>

                <Region prefWidth="20"/>

                <!-- PDF Tools Menu -->
                <MenuButton text="PDF Tools">
                    <tooltip><Tooltip text="PDF Operations"/></tooltip>
                    <items>
                        <MenuItem text="Insert page" onAction="#handleInsertPage"/>
                        <MenuItem text="Add Watermark..." onAction="#handleAddWatermark"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Merge PDFs..." onAction="#handleMergePDFs"/>
                        <MenuItem text="Split PDF..." onAction="#handleSplitPDF"/>
                        <MenuItem text="Extract Pages..." onAction="#handleExtractPages"/>
                        <MenuItem text="Reorder Pages..." onAction="#handleReorderPages"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Encrypt PDF..." onAction="#handleEncryptPDF"/>
                        <MenuItem text="Remove Password..." onAction="#handleDecryptPDF"/>
                        <MenuItem text="Show Permissions..." onAction="#handleShowPDFPermissions"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Delete Page" onAction="#handleDeletePage"/>
                        <MenuItem text="Duplicate Page..." onAction="#handleDuplicatePage"/>
                    </items>
                </MenuButton>

                <!-- View Menu -->
                <MenuButton text="View">
                    <tooltip><Tooltip text="View Options"/></tooltip>
                    <items>
                        <MenuItem text="Rotate Left (90°)" onAction="#handleRotateLeft"/>
                        <MenuItem text="Rotate Right (90°)" onAction="#handleRotateRight"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Fullscreen" onAction="#handleToggleFullScreen"/>
                    </items>
                </MenuButton>

                <!-- Annotation Tools Menu -->
                <MenuButton text="Annotate">
                    <tooltip><Tooltip text="Annotation Tools"/></tooltip>
                    <items>
                        <MenuItem text="Highlight" onAction="#handleHighlight"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Search..." onAction="#handleSearch"/>
                        <MenuItem text="Search Panel (Left)" onAction="#handleSearchLeft"/>
                        <MenuItem text="Search Panel (Right)" onAction="#handleSearchRight"/>
                    </items>
                </MenuButton>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- AI Chat Button -->
                <Button text="AI Chat" onAction="#handleOpenChat" styleClass="ai-chat-button">
                    <tooltip><Tooltip text="AI Assistant (Ctrl+Shift+A)"/></tooltip>
                </Button>
            </ToolBar>
        </VBox>
    </top>

    <!-- Center: PDF Viewer with TabPane for multiple documents -->
    <center>
        <TabPane fx:id="documentTabPane" tabClosingPolicy="ALL_TABS" styleClass="document-tab-pane">
            <!-- Welcome tab shown when no documents are open -->
            <Tab text="Welcome" closable="false">
                <StackPane styleClass="pdf-content-area">
                    <Label text="Open a PDF file to start" styleClass="welcome-text"/>
                </StackPane>
            </Tab>
        </TabPane>
    </center>

    <!-- Bottom: Status Bar -->
    <bottom>
        <HBox styleClass="status-bar" spacing="10">
            <Label fx:id="statusLabel" text="Ready"/>
        </HBox>
    </bottom>

</BorderPane>