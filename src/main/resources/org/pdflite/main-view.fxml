<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.pdflite.controller.MainController"
            prefHeight="800.0" prefWidth="1200.0">

    <!-- Top: Menu Bar and Toolbar -->
    <top>
        <VBox>
            <!-- Menu Bar -->
            <MenuBar>
                <Menu text="File">
                    <MenuItem text="Open PDF..." onAction="#handleOpenPDF" accelerator="Ctrl+O"/>
                    <Menu fx:id="recentFilesMenu" text="Recent Files">
                        <MenuItem text="No recent files" disable="true"/>
                    </Menu>
                    <MenuItem text="Clear Recent Files" onAction="#handleClearRecentFiles"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Save" onAction="#handleSave"/>
                    <MenuItem text="Save As..." onAction="#handleSaveAs"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Exit" onAction="#handleExit"/>
                </Menu>
                
                <Menu text="Edit">
                    <MenuItem text="Find..." onAction="#handleSearch" accelerator="Ctrl+F"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Hide Search Panel" onAction="#handleHideSearch" accelerator="Escape"/>
                </Menu>
    
                <Menu text="View">
                    <MenuItem text="Zoom In" onAction="#handleZoomIn" accelerator="Ctrl+Plus"/>
                    <MenuItem text="Zoom Out" onAction="#handleZoomOut" accelerator="Ctrl+Minus"/>
                    <MenuItem text="Fit to Width" onAction="#handleFitToWidth"/>
                    <MenuItem text="Fit to Page" onAction="#handleFitToPage"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Toggle Full Screen" onAction="#handleToggleFullScreen" accelerator="F11"/>
                </Menu>
    
                <Menu text="Tools">
                    <MenuItem text="Highlight" onAction="#handleHighlight"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Merge PDFs..." onAction="#handleMergePDFs"/>
                    <MenuItem text="Split PDF..." onAction="#handleSplitPDF"/>
                    <MenuItem text="Extract Pages..." onAction="#handleExtractPages"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Delete Page" onAction="#handleDeletePage"/>
                </Menu>
    
                <Menu text="Help">
                    <MenuItem text="About" onAction="#handleAbout"/>
                </Menu>
                <Menu text="Theme">
                    <MenuItem text ="Light" onAction="#setLightTheme" />
                    <MenuItem text ="Dark" onAction="#setDarkTheme" />
                </Menu>
            </MenuBar>

            <!-- Toolbar -->
            <ToolBar fx:id="toolbar" style="-fx-padding: 5;">
                <!-- File Operations -->
                <Button text="Open" onAction="#handleOpenPDF" style="-fx-font-size: 11px;"/>
                <Button text="Save" onAction="#handleSave" style="-fx-font-size: 11px;"/>
                <Separator orientation="VERTICAL"/>
                
                <!-- Navigation -->
                <Button fx:id="prevButton" text="◀" onAction="#handlePreviousPage" 
                        style="-fx-font-size: 12px; -fx-min-width: 30px;">
                    <tooltip><Tooltip text="Previous Page (Ctrl+Left)"/></tooltip>
                </Button>
                <TextField fx:id="pageNumberField" prefWidth="45" onAction="#handleGoToPage" 
                          style="-fx-font-size: 11px;"/>
                <Label fx:id="totalPagesLabel" text="/ 0" style="-fx-font-size: 11px;"/>
                <Button fx:id="nextButton" text="▶" onAction="#handleNextPage" 
                        style="-fx-font-size: 12px; -fx-min-width: 30px;">
                    <tooltip><Tooltip text="Next Page (Ctrl+Right)"/></tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                
                <!-- Zoom Controls -->
                <Button text="−" onAction="#handleZoomOut" 
                        style="-fx-font-size: 14px; -fx-min-width: 30px;">
                    <tooltip><Tooltip text="Zoom Out (Ctrl+-)"/></tooltip>
                </Button>
                <ComboBox fx:id="zoomComboBox" onAction="#handleZoomChange" 
                         prefWidth="85" style="-fx-font-size: 11px;"/>
                <Button text="+" onAction="#handleZoomIn" 
                        style="-fx-font-size: 14px; -fx-min-width: 30px;">
                    <tooltip><Tooltip text="Zoom In (Ctrl++)"/></tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                
                <!-- PDF Tools -->
                <Button text="Merge" onAction="#handleMergePDFs" 
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 11px;">
                    <tooltip><Tooltip text="Merge multiple PDFs into one"/></tooltip>
                </Button>
                <Button text="Split" onAction="#handleSplitPDF" 
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 11px;">
                    <tooltip><Tooltip text="Split PDF into multiple files"/></tooltip>
                </Button>
                <Button text="Extract" onAction="#handleExtractPages" 
                        style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 11px;">
                    <tooltip><Tooltip text="Extract specific pages"/></tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                
                <!-- Edit Tools -->
                <Button text="Highlight" onAction="#handleHighlight" style="-fx-font-size: 11px;">
                    <tooltip><Tooltip text="Toggle Highlight Mode"/></tooltip>
                </Button>
                <Button text="Delete Page" onAction="#handleDeletePage" 
                        style="-fx-font-size: 11px; -fx-text-fill: #f44336;">
                    <tooltip><Tooltip text="Delete current page"/></tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                
                <!-- Search -->
                <MenuButton text="🔍 Search" style="-fx-font-size: 11px;">
                    <tooltip><Tooltip text="Search in document (Ctrl+F)"/></tooltip>
                    <items>
                        <MenuItem text="Search Dialog..." onAction="#handleSearch"/>
                        <MenuItem text="Search Panel (Left)" onAction="#handleSearchLeft"/>
                        <MenuItem text="Search Panel (Right)" onAction="#handleSearchRight"/>
                    </items>
                </MenuButton>
                <Separator orientation="VERTICAL"/>
                
                <!-- View -->
                <Button text="Fullscreen" onAction="#handleToggleFullScreen" style="-fx-font-size: 11px;">
                    <tooltip><Tooltip text="Toggle Fullscreen (F11)"/></tooltip>
                </Button>
            </ToolBar>
        </VBox>
    </top>

    <!-- Center: PDF Viewer (side panels will be added programmatically) -->
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" fitToHeight="true">
            <StackPane fx:id="contentPane" style="-fx-background-color: #808080;">
                <Label text="Open a PDF file to start" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
            </StackPane>
        </ScrollPane>
    </center>

    <!-- Bottom: Status Bar -->
    <bottom>
        <HBox spacing="10" style="-fx-padding: 5; -fx-background-color: #f0f0f0;">
            <Label fx:id="statusLabel" text="Ready"/>
        </HBox>
    </bottom>

</BorderPane>